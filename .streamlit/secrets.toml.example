# 選擇下面其中一種方式填入 secrets.toml
# （secrets.toml 已加入 .gitignore，不會被 commit）

# ── 方式一：單一 URL（密碼不含特殊字元時使用）──────────────────────────
DATABASE_URL = "postgresql://postgres:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres"

# ── 方式二：個別參數（密碼含 @ , * 等特殊字元時建議使用）────────────────
# DB_HOST     = "db.xxxx.supabase.co"
# DB_PORT     = 5432
# DB_NAME     = "postgres"
# DB_USER     = "postgres"
# DB_PASSWORD = "your-password-with-special-chars"
